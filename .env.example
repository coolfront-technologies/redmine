# Copy to `.env` (gitignored). Used by Docker Compose (`env_file`).
#
# Docker workflow (no local Ruby needed):
#   make up          # build + start web + db
#   make bundle      # bundle install inside container
#   make logs        # follow web logs
#   open http://localhost:3000

# --- PostgreSQL ---
DATABASE_URL=postgres://postgres:password@db:5432/myapp_development

SECRET_KEY_BASE=development-secret-change-me

# --- Optional: local Docker only (do NOT add these in Azure App Service) ---
#
# S3 plugin: skip create_bucket at boot when you have no AWS credentials (Compose on laptop).
SKIP_S3_BOOTSTRAP=1

# Migrations: local Compose has no WEBSITE_SITE_NAME, so rake db:migrate runs by default.
# When DATABASE_URL points at shared/prod, set REDMINE_NO_DB_MIGRATE=1 — OR rely on Azure in prod:
# Azure App Service always sets WEBSITE_SITE_NAME; /start.sh skips migrations automatically there.

# REDMINE_NO_DB_MIGRATE=1

# If Redmine is hosted under a subpath (fixes broken CSS/layout):
# REDMINE_RELATIVE_URL_ROOT=/redmine

